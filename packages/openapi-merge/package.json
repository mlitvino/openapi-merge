{
  "name": "@mlitvino/openapi-merge",
  "version": "0.0.1",
  "description": "Merge multiple OpenAPI 3.0 documents into a single deterministic specification, with governed conflict resolution for paths, components, and operationIds, plus $ref integrity preservation.",
  "license": "MIT",
  "author": "Mykhailo Litvinov <mi.litvino@gmail.com>",
  "keywords": [
    "openapi",
    "swagger",
    "openapi3",
    "merge",
    "combine",
    "bundle",
    "specification"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mlitvino/openapi-merge.git"
  },
  "homepage": "https://github.com/mlitvino/openapi-merge#readme",
  "bugs": {
    "url": "https://github.com/mlitvino/openapi-merge/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "tsx test/e2e/main.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@scalar/openapi-types": "^0.8.0",
    "yaml": "^2.9.0"
  }
}
