{
  "typescript": {
    "semiColons": "prefer",
    "quoteStyle": "preferSingle",
    "trailingCommas": "onlyMultiLine",
    "indentWidth": 2,
    "lineWidth": 100,
    "newLineKind": "lf",
    "module.sortImportDeclarations": "maintain",
    "quoteProps": "asNeeded"
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json"
  ],
  "plugins": [
    "https://plugins.dprint.dev/typescript-0.96.1.wasm"
  ]
}
