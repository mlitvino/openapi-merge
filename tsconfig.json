{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],

    "moduleResolution": "bundler",
    "module": "ES2022",
    "strict": true,
    "skipLibCheck": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "forceConsistentCasingInFileNames": true,

    "declaration": true,
    "declarationMap": true,

    "sourceMap": true,

    "outDir": "dist",

    "baseUrl": ".",

    "types": ["node"]
  }
}
