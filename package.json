{
  "name": "openapi-merge",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "format": "pnpm dprint fmt",
    "format:check": "pnpm dprint check",
    "lint": "pnpm --filter openapi-merge lint",
    "lint:fix": "pnpm --filter openapi-merge lint --fix",
    "lint:staged": "pnpm lint:fix && pnpm format",
    "test": "pnpm --filter openapi-merge test",
    "typecheck": "pnpm --filter openapi-merge typecheck",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7"
  },
  "dependencies": {
    "dprint": "^0.54.0"
  }
}
